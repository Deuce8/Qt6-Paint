QMainWindow {
    background-color: #1d1d20;
}

QListWidget {
    background-color: #222226;
    border: 1px solid #ffffff;
    color: #ffffff;
    font-size: 14px;
}

QListWidget:item:hover {
    background-color: #e62d42;
    border: 1px solid #ffffff;
    color: #222226;
    padding: -1px;
}

QListWidget:item:selected {
    background-color: #e62d42;
    border: 1px solid #ffffff;
    color: #222226;
    padding: -1px;
}

QToolButton {
    border: 1px solid white;
    background-color: none;
}

QToolButton:hover{
    background-color : #e62d42;
}

QToolButton:checked,
QToolButton:pressed {
    background-color: #e62d42;
    margin: 0px;
}

LayerMenu QPushButton,
QToolBar QPushButton {
    border: 1px solid white;
    background-color: none;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
}

QPushButton:hover{
    background-color : #e62d42;
}

QPushButton:pressed {
    background-color: #e62d42;
}

QToolBar {
    background-color: #222226;
    spacing: 0px;
}

QLabel {
    color: #ffffff;
    font-size: 12px;
}

QLineEdit {
    background-color: #222226;
    color: #ffffff;
    border: 1px solid white;
}

QDialog {
    background-color: #222226;
    color: #ffffff;
}

QDialog QPushButton {
    border: 1px solid white;
    color: #ffffff;
}

QDialog QToolButton {
    border: 1px solid white;
    color: #ffffff;
    min-width: 0px;
    min-height: 0px;
    max-width: 1000px;
    max-height: 1000px;
}

QDialog QComboBox {
    border: 1px solid white;
    background-color: none;
}

QDialog QComboBox::drop-down {
    border: 1px solid white;
    background-color: #222226;
    color: #000000;
}

QDialog {
    background-color: #1d1d20; 
}